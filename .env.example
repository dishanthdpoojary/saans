# All keys are optional — Saans runs on Open-Meteo (no key) alone.
# Each key unlocks an additional authentic data source or feature.

# World Air Quality Index Project — live ground-station AQI + map stations
# Free token: https://aqicn.org/data-platform/token/
WAQI_TOKEN=

# OpenAQ v3 — raw station concentrations (µg/m³)
# Free key: https://explore.openaq.org/register
OPENAQ_API_KEY=

# Google Gemini — AI assistant & AI insights (falls back to built-in rules without it)
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
